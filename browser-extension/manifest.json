{
	"manifest_version": 3,
	"name": "SWE Job Tracker Clipper",
	"version": "0.2.0",
	"description": "Detects job postings and pre-fills the SWE Job Tracker \"Add application\" form in Obsidian, and autofills job applications.",
	"permissions": ["storage"],
	"action": {
		"default_title": "SWE Job Tracker",
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"autofill": {
			"suggested_key": { "default": "Alt+Shift+F" },
			"description": "Autofill the job application on this page"
		}
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["comp-parse.js", "content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["profile-fields.js", "autofill.js"],
			"run_at": "document_idle",
			"all_frames": true
		}
	]
}
