{
  "name": "obsidian-swe-job-tracker",
  "version": "0.2.1",
  "description": "Track software engineering applications through OA, recruiter screen, and interview rounds with Kanban, Table, List, and Sankey analytics.",
  "main": "main.js",
  "scripts": {
    "test:auto-ghost": "node scripts/test-auto-ghost.mjs",
    "test:sankey": "node scripts/test-sankey.mjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "install-plugin": "node scripts/install.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "job-tracker",
    "software-engineering",
    "internship"
  ],
  "author": "js0nt",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
